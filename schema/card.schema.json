{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "IndianCard",
  "type": "object",
  "required": ["card_id", "issuer_id", "card_name", "category", "source_url"],
  "properties": {
    "card_id":          { "type": "string", "description": "slug: issuer_id + '__' + slugified card_name" },
    "issuer_id":        { "type": "string" },
    "issuer_name":      { "type": "string" },
    "card_name":        { "type": "string" },
    "card_variant":     { "type": ["string","null"] },
    "card_material":    { "type": ["string","null"], "enum": [null,"metal","plastic","virtual","co-branded"] },
    "network":          { "type": ["string","null"], "enum": [null,"Visa","Mastercard","RuPay","Amex","Diners","Discover"] },
    "category":         { "type": "string", "enum": ["credit","debit","prepaid","forex","corporate","business","transit","fuel","metal","virtual","other"] },
    "segment":          { "type": ["string","null"], "enum": [null,"entry","mid","premium","super-premium","invite-only","student","secured","nri"] },
    "status":           { "type": "string", "enum": ["active","discontinued","upcoming","invite_only","unknown"], "default": "active" },
    "launch_date":      { "type": ["string","null"], "format": "date" },
    "discontinued_on":  { "type": ["string","null"], "format": "date" },

    "fees": {
      "type": "object",
      "properties": {
        "joining_fee_inr":        { "type": ["number","null"] },
        "annual_fee_inr":         { "type": ["number","null"] },
        "renewal_fee_inr":        { "type": ["number","null"] },
        "fee_waiver_spend_inr":   { "type": ["number","null"] },
        "addon_card_fee_inr":     { "type": ["number","null"] },
        "fx_markup_pct":          { "type": ["number","null"] },
        "cash_advance_fee_pct":   { "type": ["number","null"] },
        "finance_charge_pct_mo":  { "type": ["number","null"] },
        "fuel_surcharge_waiver":  { "type": ["string","null"] },
        "gst_extra":              { "type": "boolean", "default": true }
      }
    },

    "rewards": {
      "type": "object",
      "properties": {
        "base_rate_pct":    { "type": ["number","null"] },
        "currency":         { "type": ["string","null"], "enum": [null,"points","miles","cashback","neucoins","edge_miles","cred_coins","other"] },
        "point_value_inr":  { "type": ["number","null"] },
        "accelerated": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category":   { "type": "string" },
              "rate_pct":   { "type": ["number","null"] },
              "cap_inr":    { "type": ["number","null"] },
              "notes":      { "type": ["string","null"] }
            }
          }
        },
        "exclusions":         { "type": "array", "items": { "type": "string" } },
        "redemption_modes":   { "type": "array", "items": { "type": "string" } },
        "expiry_months":      { "type": ["integer","null"] }
      }
    },

    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "spend_inr":  { "type": "number" },
          "reward":     { "type": "string" },
          "value_inr":  { "type": ["number","null"] },
          "period":     { "type": ["string","null"], "enum": [null,"monthly","quarterly","anniversary","annual"] }
        }
      }
    },

    "welcome_benefit": { "type": ["string","null"] },

    "partner_offers": {
      "type": "array",
      "description": "Brand-specific cashback / discount offers (Swiggy, Amazon, BookMyShow, etc.)",
      "items": {
        "type": "object",
        "properties": {
          "partner":  { "type": "string" },
          "benefit":  { "type": "string", "description": "Full offer text including %, max amount, min spend, frequency" }
        },
        "required": ["partner","benefit"]
      }
    },

    "lounge_access": {
      "type": "object",
      "properties": {
        "domestic_visits_year":      { "type": ["integer","null"] },
        "international_visits_year": { "type": ["integer","null"] },
        "guest_allowed":             { "type": ["boolean","null"] },
        "program":                   { "type": ["string","null"] },
        "spend_unlock_inr":          { "type": ["number","null"] }
      }
    },

    "insurance": {
      "type": "object",
      "properties": {
        "air_accident_inr":          { "type": ["number","null"] },
        "lost_card_inr":             { "type": ["number","null"] },
        "purchase_protection_inr":   { "type": ["number","null"] },
        "travel_inr":                { "type": ["number","null"] }
      }
    },

    "perks": {
      "type": "array",
      "description": "All remaining benefits — golf, movies, dining, spa, concierge, subscriptions, etc.",
      "items": {
        "type": "object",
        "properties": {
          "kind":   { "type": "string" },
          "value":  { "type": "string" }
        },
        "required": ["kind","value"]
      }
    },

    "eligibility": {
      "type": "object",
      "properties": {
        "min_age":              { "type": ["integer","null"] },
        "max_age":              { "type": ["integer","null"] },
        "min_income_inr_year":  { "type": ["number","null"] },
        "min_credit_score":     { "type": ["integer","null"] },
        "salaried":             { "type": ["boolean","null"] },
        "self_employed":        { "type": ["boolean","null"] },
        "income_proof":         { "type": "array", "items": { "type": "string" } }
      }
    },

    "apply_url":         { "type": ["string","null"], "format": "uri" },
    "tnc_url":           { "type": ["string","null"], "format": "uri" },
    "mitc_url":          { "type": ["string","null"], "format": "uri" },
    "image_url":         { "type": ["string","null"], "format": "uri" },
    "source_url":        { "type": "string", "format": "uri" },
    "source_archive_s3": { "type": ["string","null"] },
    "raw_text_sha256":   { "type": ["string","null"] },
    "last_scraped_at":   { "type": "string", "format": "date-time" },
    "first_seen_at":     { "type": "string", "format": "date-time" },
    "confidence":        { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
