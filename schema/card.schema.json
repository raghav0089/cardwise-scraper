{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "IndianCard",
  "description": "Unified, detailed schema for an Indian payment card. Typed fields for the things people compare (fees, reward currency + value, named category rewards, named partner offers, lounge, insurance, EMI, forex), plus highlights[] keeping every raw line verbatim.",
  "type": "object",
  "required": ["card_id", "issuer_id", "card_name", "category", "source_url"],
  "properties": {
    "card_id":          { "type": "string", "description": "issuer_id + '__' + slugified card_name" },
    "issuer_id":        { "type": "string" },
    "issuer_name":      { "type": ["string", "null"] },
    "card_name":        { "type": "string" },
    "card_variant":     { "type": ["string", "null"] },
    "co_brand":         { "type": ["string", "null"], "description": "co-brand partner if any (Swiggy, Tata Neu, IndianOil, IndiGo, ...)" },
    "card_material":    { "type": ["string", "null"], "enum": [null, "metal", "plastic", "virtual", "co-branded"] },
    "network":          { "type": ["string", "null"], "enum": [null, "Visa", "Mastercard", "RuPay", "Amex", "Diners", "Discover"] },
    "category":         { "type": "string", "enum": ["credit", "debit", "prepaid", "forex", "corporate", "business", "transit", "fuel", "other"] },
    "segment":          { "type": ["string", "null"], "enum": [null, "entry", "mid", "premium", "super-premium", "invite-only", "student", "secured", "nri"] },
    "status":           { "type": "string", "enum": ["active", "discontinued", "upcoming", "invite_only", "unknown"], "default": "active" },

    "fees": {
      "type": "object",
      "properties": {
        "joining_fee_inr":        { "type": ["number", "null"] },
        "annual_fee_inr":         { "type": ["number", "null"] },
        "renewal_fee_inr":        { "type": ["number", "null"] },
        "fee_waiver_spend_inr":   { "type": ["number", "null"], "description": "annual spend that waives the renewal fee" },
        "lifetime_free":          { "type": ["boolean", "null"] },
        "addon_card_fee_inr":     { "type": ["number", "null"] },
        "fx_markup_pct":          { "type": ["number", "null"] },
        "cash_advance_fee_pct":   { "type": ["number", "null"] },
        "finance_charge_pct_mo":  { "type": ["number", "null"] },
        "reward_redemption_fee_inr": { "type": ["number", "null"] },
        "fuel_surcharge_waiver":  { "type": ["string", "null"] },
        "gst_extra":              { "type": ["boolean", "null"], "default": true }
      }
    },

    "rewards": {
      "type": "object",
      "properties": {
        "currency":          { "type": ["string", "null"], "description": "exact unit name: Cashback, Reward Points, CashPoints, NeuCoins, EDGE Miles, 6E Rewards, etc." },
        "currency_value_inr":{ "type": ["number", "null"], "description": "₹ value of 1 unit (e.g. 1 point = ₹0.25, 1 NeuCoin = ₹1)" },
        "base_rate_pct":     { "type": ["number", "null"], "description": "default earn rate as % of spend on all/other spends" },
        "is_cashback":       { "type": ["boolean", "null"], "description": "true if reward is direct cashback (no point conversion)" },

        "category_rewards": {
          "type": "object",
          "description": "Explicit, named spend categories. Each is { rate_pct, value_back_pct, cap_inr, cap_period, notes } — null/absent if the card has no special rate there.",
          "properties": {
            "dining":            { "$ref": "#/$defs/catReward" },
            "swiggy":            { "$ref": "#/$defs/catReward" },
            "zomato":            { "$ref": "#/$defs/catReward" },
            "food_delivery":     { "$ref": "#/$defs/catReward" },
            "fuel":              { "$ref": "#/$defs/catReward" },
            "grocery":           { "$ref": "#/$defs/catReward" },
            "online_shopping":   { "$ref": "#/$defs/catReward" },
            "amazon":            { "$ref": "#/$defs/catReward" },
            "flipkart":          { "$ref": "#/$defs/catReward" },
            "myntra":            { "$ref": "#/$defs/catReward" },
            "flights":           { "$ref": "#/$defs/catReward" },
            "hotels":            { "$ref": "#/$defs/catReward" },
            "travel":            { "$ref": "#/$defs/catReward" },
            "international":      { "$ref": "#/$defs/catReward" },
            "utilities":         { "$ref": "#/$defs/catReward" },
            "bill_payments":     { "$ref": "#/$defs/catReward" },
            "upi":               { "$ref": "#/$defs/catReward" },
            "movies":            { "$ref": "#/$defs/catReward" },
            "entertainment":     { "$ref": "#/$defs/catReward" },
            "insurance":         { "$ref": "#/$defs/catReward" },
            "rent":              { "$ref": "#/$defs/catReward" },
            "education":         { "$ref": "#/$defs/catReward" },
            "wallet_load":       { "$ref": "#/$defs/catReward" },
            "departmental_store":{ "$ref": "#/$defs/catReward" },
            "smartbuy_portal":   { "$ref": "#/$defs/catReward", "description": "bank reward portal (SmartBuy / iShop / Grab / Reward Hub)" }
          },
          "additionalProperties": { "$ref": "#/$defs/catReward" }
        },

        "accelerated": {
          "type": "array",
          "description": "Any earn rates that don't map to a named category above.",
          "items": { "$ref": "#/$defs/catReward" }
        },
        "redemption_modes":  { "type": "array", "items": { "type": "string" } },
        "transfer_partners": { "type": "array", "items": { "type": "string" }, "description": "airline/hotel point-transfer partners" },
        "exclusions":        { "type": "array", "items": { "type": "string" }, "description": "categories earning NO reward" },
        "expiry_months":     { "type": ["integer", "null"] },
        "monthly_cap_inr":   { "type": ["number", "null"], "description": "overall monthly reward cap if any" }
      }
    },

    "partner_offers": {
      "type": "array",
      "description": "Named brand offers (Swiggy, Zomato, Amazon, BookMyShow, MakeMyTrip, Cult.fit, ...).",
      "items": {
        "type": "object",
        "properties": {
          "partner":      { "type": "string" },
          "offer_type":   { "type": ["string", "null"], "enum": [null, "cashback", "discount", "voucher", "membership", "bogo", "free_delivery", "other"] },
          "value_pct":    { "type": ["number", "null"] },
          "value_inr":    { "type": ["number", "null"] },
          "cap_inr":      { "type": ["number", "null"] },
          "frequency":    { "type": ["string", "null"], "description": "e.g. per month, per order, 2 orders/month" },
          "min_spend_inr":{ "type": ["number", "null"] },
          "detail":       { "type": "string" }
        },
        "required": ["partner", "detail"]
      }
    },

    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "spend_inr":  { "type": "number" },
          "period":     { "type": ["string", "null"], "enum": [null, "monthly", "quarterly", "anniversary", "annual"] },
          "reward":     { "type": "string" },
          "value_inr":  { "type": ["number", "null"] }
        }
      }
    },

    "welcome_benefit": {
      "type": "object",
      "properties": {
        "value_inr":    { "type": ["number", "null"] },
        "min_spend_inr":{ "type": ["number", "null"] },
        "within_days":  { "type": ["integer", "null"] },
        "detail":       { "type": ["string", "null"] }
      }
    },

    "lounge_access": {
      "type": "object",
      "properties": {
        "domestic_visits_year":      { "type": ["integer", "null"] },
        "international_visits_year": { "type": ["integer", "null"] },
        "unlimited_domestic":        { "type": ["boolean", "null"] },
        "unlimited_international":    { "type": ["boolean", "null"] },
        "railway_lounge_year":       { "type": ["integer", "null"] },
        "guest_allowed":             { "type": ["boolean", "null"] },
        "program":                   { "type": ["string", "null"], "description": "Priority Pass / DreamFolks / LoungeKey / own network" },
        "spend_unlock_inr":          { "type": ["number", "null"], "description": "min spend per period to unlock the visits" }
      }
    },

    "insurance": {
      "type": "object",
      "properties": {
        "air_accident_inr":          { "type": ["number", "null"] },
        "personal_accident_inr":     { "type": ["number", "null"] },
        "lost_card_liability_inr":   { "type": ["number", "null"] },
        "purchase_protection_inr":   { "type": ["number", "null"] },
        "travel_insurance_inr":      { "type": ["number", "null"] },
        "baggage_loss_inr":          { "type": ["number", "null"] },
        "flight_delay_inr":          { "type": ["number", "null"] },
        "credit_shield_inr":         { "type": ["number", "null"] }
      }
    },

    "emi": {
      "type": "object",
      "description": "EMI / no-cost-EMI features (2nd most common feature in the data).",
      "properties": {
        "no_cost_emi":          { "type": ["boolean", "null"] },
        "interest_free_days":   { "type": ["integer", "null"] },
        "min_txn_inr":          { "type": ["number", "null"] },
        "processing_fee":       { "type": ["string", "null"] },
        "detail":               { "type": ["string", "null"] }
      }
    },

    "forex": {
      "type": "object",
      "description": "Forex / multi-currency features.",
      "properties": {
        "markup_pct":           { "type": ["number", "null"] },
        "zero_markup":          { "type": ["boolean", "null"] },
        "multi_currency":       { "type": ["boolean", "null"] },
        "supported_currencies": { "type": ["integer", "null"] },
        "detail":               { "type": ["string", "null"] }
      }
    },

    "perks": {
      "type": "array",
      "description": "Everything else, normalized: golf, movie, concierge, spa, hotel memberships, subscriptions, vouchers, roadside assist, etc.",
      "items": {
        "type": "object",
        "properties": {
          "kind":   { "type": "string", "enum": ["golf", "movie", "dining", "spa", "concierge", "hotel", "subscription", "voucher", "gift_card", "railway_lounge", "roadside_assist", "annual_voucher", "contactless", "virtual_card", "buy_one_get_one", "other"] },
          "value_inr": { "type": ["number", "null"] },
          "detail": { "type": "string" }
        },
        "required": ["kind", "detail"]
      }
    },

    "eligibility": {
      "type": "object",
      "properties": {
        "min_age":              { "type": ["integer", "null"] },
        "max_age":              { "type": ["integer", "null"] },
        "min_income_inr_year":  { "type": ["number", "null"] },
        "min_income_inr_month": { "type": ["number", "null"] },
        "min_credit_score":     { "type": ["integer", "null"] },
        "salaried":             { "type": ["boolean", "null"] },
        "self_employed":        { "type": ["boolean", "null"] },
        "secured_against_fd":   { "type": ["boolean", "null"] }
      }
    },

    "highlights": {
      "type": "array",
      "description": "Every substantive benefit/reward/fee line captured VERBATIM from the page — the audit trail and fallback for anything not yet normalized.",
      "items": { "type": "string" }
    },

    "apply_url":         { "type": ["string", "null"] },
    "image_url":         { "type": ["string", "null"] },
    "source_url":        { "type": "string" },
    "raw_text_sha256":   { "type": ["string", "null"] },
    "last_scraped_at":   { "type": ["string", "null"] },
    "first_seen_at":     { "type": ["string", "null"] },
    "confidence":        { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
  },

  "$defs": {
    "catReward": {
      "type": "object",
      "description": "Reward earned in a spend category.",
      "properties": {
        "rate_pct":       { "type": ["number", "null"], "description": "effective value-back % of spend" },
        "raw_rate":       { "type": ["string", "null"], "description": "as stated, e.g. '10X points' or '5 CashPoints per ₹150'" },
        "cap_inr":        { "type": ["number", "null"] },
        "cap_period":     { "type": ["string", "null"], "enum": [null, "daily", "monthly", "quarterly", "annual", "statement", "per_transaction"] },
        "notes":          { "type": ["string", "null"] }
      }
    }
  }
}
